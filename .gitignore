# ══════════════════════════════════════════════════════════════════════════════
#  SentinelBorder — .gitignore
#  Protects secrets, credentials, generated artefacts and local-only files.
# ══════════════════════════════════════════════════════════════════════════════

# ── Secrets & Credentials ────────────────────────────────────────────────────
.env
.env.*
!.env.example          # keep the template
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
secrets/
credentials/
service_account*.json
*_credentials.json
*_secret*.json
google-credentials.json
firebase*.json

# ── Python generated files ────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.pyd
*.pyo
*.pyc

# ── Build & Distribution ──────────────────────────────────────────────────────
build/
dist/
wheels/
*.egg-info/
*.egg
MANIFEST

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.bak

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
nosetests.xml
*.cover
*.log

# ── Type checkers & Linters ───────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyright/

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── AI / ML Models & Large Binary Data ───────────────────────────────────────
# Prevent accidentally committing downloaded model weights / biometric data
models/
*.pt
*.pth
*.onnx
*.h5
*.pkl
*.joblib
*.npy
*.npz

# ── Biometric / Document Test Data (sensitive) ───────────────────────────────
# Sample passport scans, face images, or any PII test data must NEVER be pushed
test_data/
sample_docs/
fixtures/images/
fixtures/documents/
*.passport.*
*_face.*
*_live.*

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ── OS generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Node (frontend assets, if any) ───────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temporary / scratch files ─────────────────────────────────────────────────
tmp/
temp/
scratch/
*.tmp
*.bak
*.swp
*.orig
